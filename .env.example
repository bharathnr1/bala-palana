# Supabase project (free plan, Mumbai region, one project for previews and production, D30)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. DATABASE_URL is the transaction pooler (port 6543) used by the app;
# DIRECT_URL is the session pooler (port 5432) used by migrations and pg_dump.
DATABASE_URL=
DIRECT_URL=

# Absolute URL for auth redirects, e.g. http://localhost:3000
APP_URL=http://localhost:3000

# The first admin's email. The seed creates their app_user row.
BOOTSTRAP_ADMIN_EMAIL=

# password (default) | test. `test` shows the "sign in as …" list; it is refused
# whenever VERCEL_ENV is set.
AUTH_MODE=password
